<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.agentos.home"
    android:versionCode="1" android:versionName="0.1">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.READ_CALENDAR"/>
  <uses-permission android:name="android.permission.EXPAND_STATUS_BAR"/>
  <!-- wake word (Wake.java): mic foreground service + its notification; overlay appop lets it bring voice mode up over other apps -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <!-- package visibility for the app drawer -->
  <queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent></queries>
  <application android:label="AgentOS Home" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name=".Home" android:exported="true" android:launchMode="singleTask" android:stateNotNeeded="true"
        android:excludeFromRecents="true" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.HOME"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <!-- Micro-apps (agentd apps.js): one activity, its own task, a sandboxed WebView per app (MicroApp.java) -->
    <activity android:name=".MicroApp" android:exported="false" android:launchMode="singleTop" android:taskAffinity="local.agentos.home.apps"
        android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden"/>
    <service android:name=".Wake" android:exported="false" android:foregroundServiceType="microphone"/>
    <!-- The system camera's one write target for Attach › Camera (Home.Shot); per-capture grant only -->
    <provider android:name=".Home$Shot" android:authorities="local.agentos.home.shot" android:exported="false" android:grantUriPermissions="true"/>
  </application>
</manifest>
