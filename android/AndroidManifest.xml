<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.agentos"
    android:versionCode="1" android:versionName="0.1">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
  <!-- Wake: the schedule's exact alarm (works in deep doze) and keeping the screen on while an unlocked task runs. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <!-- Api.java: Android's own services instead of taps (android/API-ACTIONS.md). Runtime ones are granted by install.sh. -->
  <uses-permission android:name="android.permission.READ_CALENDAR"/>
  <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
  <uses-permission android:name="android.permission.READ_CONTACTS"/>
  <uses-permission android:name="android.permission.SEND_SMS"/>
  <uses-permission android:name="android.permission.READ_SMS"/>
  <uses-permission android:name="android.permission.READ_CALL_LOG"/>
  <uses-permission android:name="android.permission.CALL_PHONE"/>
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
  <application android:label="AgentOS" android:icon="@android:drawable/ic_lock_lock" android:allowBackup="false">
    <service android:name=".DeepModService" android:exported="true"/>
    <!-- The bouncer: reads the screen, acts, and hosts the tool server on 127.0.0.1:7777. -->
    <service android:name=".AgentA11y" android:exported="true" android:label="AgentOS"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/a11y"/>
    </service>
    <!-- The notification feed (recent messages + their Reply actions). cmd notification allow_listener local.agentos/local.agentos.Notifs -->
    <service android:name=".Notifs" android:exported="true" android:label="AgentOS"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
    </service>
    <!-- The owner's "Add password" screen (opened from the launcher's Passwords view). The password is typed and encrypted here, in this process. -->
    <activity android:name=".VaultAddActivity" android:exported="true" android:excludeFromRecents="true" android:label="Add password"
        android:windowSoftInputMode="adjustResize" android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>
    <!-- Transparent host for the fingerprint prompt that signs one exact action. -->
    <activity android:name=".ApproveActivity" android:exported="false" android:excludeFromRecents="true"
        android:noHistory="true" android:taskAffinity="local.agentos.approve"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
  </application>
</manifest>
