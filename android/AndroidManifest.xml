<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.agentos"
    android:versionCode="1" android:versionName="0.1">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
  <application android:label="AgentOS" android:icon="@android:drawable/ic_lock_lock" android:allowBackup="false">
    <!-- The bouncer: reads the screen, acts, and hosts the tool server on 127.0.0.1:7777. -->
    <service android:name=".AgentA11y" android:exported="true" android:label="AgentOS"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/a11y"/>
    </service>
    <!-- The notification feed (recent messages + their Reply actions). cmd notification allow_listener local.agentos/local.agentos.Notifs -->
    <service android:name=".Notifs" android:exported="true" android:label="AgentOS"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
    </service>
    <!-- Transparent host for the fingerprint prompt that signs one exact action. -->
    <activity android:name=".ApproveActivity" android:exported="false" android:excludeFromRecents="true"
        android:noHistory="true" android:taskAffinity="local.agentos.approve"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
  </application>
</manifest>
