<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.agentos.appmod">
  <!-- Only to read a target app's public font resource so the mod's label matches (Android 11 package visibility). -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
  <application android:label="AgentOS Mods" android:allowBackup="false">
    <!-- Reads the target app's on-screen tree, presses its own buttons, and draws the mod as an accessibility overlay. -->
    <service android:name=".ModService" android:exported="true" android:label="AgentOS Mods"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/appmod_a11y"/>
    </service>
    <!-- apply/remove/list. DUMP is held by adb shell and system only, so no app on the phone can inject a mod. -->
    <receiver android:name=".ModCmd" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter>
        <action android:name="local.agentos.appmod.APPLY"/>
        <action android:name="local.agentos.appmod.REMOVE"/>
        <action android:name="local.agentos.appmod.LIST"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
